<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.demo1.VehicleController" spacing="15" alignment="CENTER">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Vehicle Registry" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="makeInput" promptText="Make"/>
        <TextField fx:id="modelInput" promptText="Model"/>
        <TextField fx:id="yearInput" promptText="Year"/>
        <Button text="Add Vehicle" onAction="#handleAddVehicle"/>
    </HBox>

    <TableView fx:id="vehicleTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="makeCol" text="Make" prefWidth="150"/>
            <TableColumn fx:id="modelCol" text="Model" prefWidth="150"/>
            <TableColumn fx:id="yearCol" text="Year" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>