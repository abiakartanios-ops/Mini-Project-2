<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cardealershipclone1.controllers.ClientsController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: linear-gradient(to right, #0f172a, #1e293b);">

    <padding>
        <Insets top="40" right="70" bottom="40" left="70"/>
    </padding>

    <HBox spacing="0" maxWidth="1050" prefWidth="1050" prefHeight="580"
          style="-fx-background-color: white; -fx-background-radius: 20;">

        <!-- LEFT PANEL -->
        <VBox spacing="15" prefWidth="330"
              style="-fx-background-color: #111827; -fx-background-radius: 20 0 0 20;">
            <padding>
                <Insets top="25" right="20" bottom="25" left="20"/>
            </padding>

            <Label text="Clients"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" />

            <Label text="Manage your clients"
                   style="-fx-font-size: 14px; -fx-text-fill: #9ca3af;" />

            <Region prefHeight="10"/>

            <TextField fx:id="idField" promptText="Client ID"/>
            <TextField fx:id="nameField" promptText="Client Name"/>
            <TextField fx:id="phoneField" promptText="Phone"/>
            <TextField fx:id="emailField" promptText="Email"/>
            <TextField fx:id="addressField" promptText="Address"/>
        </VBox>

        <!-- RIGHT PANEL -->
        <VBox spacing="12" prefWidth="720">
            <padding>
                <Insets top="25" right="25" bottom="25" left="30"/>
            </padding>

            <Label text="Clients Management"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;" />

            <TableView fx:id="clientsTable" prefHeight="350">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="120"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="150"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="180"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button text="Add" onAction="#addClient"
                        style="-fx-background-color: #22c55e; -fx-text-fill: white;"/>
                <Button text="Update" onAction="#updateClient"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                <Button text="Delete" onAction="#deleteClient"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
                <Button text="Clear" onAction="#clearFields"
                        style="-fx-background-color: #6b7280; -fx-text-fill: white;"/>
            </HBox>

        </VBox>

    </HBox>
</VBox>